{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ducklab: Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vs-extension",
        "--new-window",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/vs-extension/out/**/*.js"
      ]
    }
  ]
}
